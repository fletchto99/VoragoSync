{
  "name": "voragosync",
  "version": "0.1.0",
  "description": "Native Vorago transition timer for RuneScape 3.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fletchto99/VoragoSync.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:release": "tsx --test tests/native.test.ts",
    "build:release": "tsx scripts/build-release.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wasmoon": "1.16.0"
  }
}
